# Cloudflare Pages custom headers: place in the deploy root (same folder as index.html)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  # Report-Only first: check the browser console for violations, then rename to Content-Security-Policy
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'

/images/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# Keep the free *.pages.dev address out of search results (duplicate of the custom domain)
https://:project.pages.dev/*
  X-Robots-Tag: noindex
